# J.A.R.V.I.S. — Environment Variables
# Copy this file to .env and fill in your API keys.
# Never commit .env to version control.

# Google Gemini API key (required for AI conversation)
GEMINI_API_KEY=

# OpenAI API key (optional, for GPT fallback)
OPENAI_API_KEY=

# Ollama host (optional, for local LLM)
OLLAMA_HOST=http://localhost:11434
